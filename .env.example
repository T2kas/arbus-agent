# Required — Claude API key (generation, structuring, verification fallback)
ANTHROPIC_API_KEY=sk-ant-...

# Optional — Perplexity Sonar for the already-decided verification pass.
# If unset, verification falls back to Claude + web search.
PERPLEXITY_API_KEY=

# Optional — Telegram alert when a batch is ready (bot token + target chat)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

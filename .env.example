# One LLM key required. Provider auto-detected; force with LLM_PROVIDER=perplexity|anthropic
PERPLEXITY_API_KEY=pplx-...
# ANTHROPIC_API_KEY=sk-ant-...

# Telegram bot: token from @BotFather; chat id via the bot's /id command
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — enriches the PULSE stage (real trend signal). Zero-auth pulse
# sources (Google Trends LT, Reddit, Wikipedia LT) work without any of these.
# YOUTUBE_API_KEY=          # YouTube Data API v3 key -> Trending LT videos

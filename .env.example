# One LLM key required. Provider auto-detected; force with
# LLM_PROVIDER=perplexity|anthropic|zai
#
# COST: an all-Claude Opus batch runs ~$5. Recommended split — cheap drafting,
# sharp verification (see README "Cost control"):
#   LLM_PROVIDER=perplexity
#   LLM_PROVIDER_VERIFY=anthropic
# Optional: ANTHROPIC_MODEL=claude-sonnet-5 (default), ANTHROPIC_THINKING=off
PERPLEXITY_API_KEY=pplx-...
# ANTHROPIC_API_KEY=sk-ant-...
# ZAI_API_KEY=...          # Z.AI (Zhipu GLM). NOT search-native — grounding
#                          # comes from Z.AI's web_search tool; if that tool is
#                          # unavailable the model answers from memory.

# Telegram bot: token from @BotFather; chat id via the bot's /id command
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — enriches the PULSE stage (real trend signal). Zero-auth pulse
# sources (Google Trends LT, Reddit, Wikipedia LT) work without any of these.
# YOUTUBE_API_KEY=          # YouTube Data API v3 key -> Trending LT videos
